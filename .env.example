# ============================================
# 环境变量示例
# 使用方法：复制本文件为 .env 后按需修改
#   cp .env.example .env
# ============================================

# --------------------------------------------------
# 数据库连接（切换数据库只需修改这一行）
# --------------------------------------------------
# 默认：不设置 DATABASE_URL 时自动使用 SQLite（database/erp.db）
#
# 切换 MySQL（root/123456 请替换为真实账号密码，需先创建 erp_db 数据库）：
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/erp_db?charset=utf8mb4
#
# 指定 SQLite 文件位置（绝对路径）：
# DATABASE_URL=sqlite:////home/user/pet-collar-erp/database/erp.db
# --------------------------------------------------

# Flask 调试模式：1=开启（代码改动自动重载），生产环境必须为 0
FLASK_DEBUG=0
