# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ---------------- 虚拟环境（各自本地创建，不入库）----------------
.venv/
venv/
env/
ENV/

# ---------------- 环境变量（含数据库密码，禁止提交）----------------
.env

# ---------------- 数据库文件 ----------------
# 由 python backend/seed.py 自动生成，不纳入版本管理；
# 克隆项目后执行一次 seed 即可获得完整演示数据。
database/*.db
database/*.sqlite3
database/*.db-journal

# ---------------- 编辑器 / 操作系统 ----------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------- 日志与临时文件 ----------------
*.log
*.tmp
